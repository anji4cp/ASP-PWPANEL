# HTTP bootstrap configuration for the public PWKU portal.
# Point the A records for pwku.cloud and www.pwku.cloud to the VPS first,
# enable this site, then run:
#   certbot --nginx -d pwku.cloud -d www.pwku.cloud --redirect
server {
    listen 80;
    listen [::]:80;

    server_name pwku.cloud www.pwku.cloud;

    # Keep authenticated account and administration pages on the panel host.
    location = /login {
        return 302 https://panel.pwku.cloud/login;
    }

    location = /panel {
        return 302 https://panel.pwku.cloud/panel;
    }

    location = /admin {
        return 302 https://panel.pwku.cloud/admin;
    }

    location ^~ /admin/ {
        return 302 https://panel.pwku.cloud$request_uri;
    }

    location / {
        proxy_pass http://10.77.0.2:8080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite rather than append untrusted client input. PWPanel accepts
        # this header only from the allowlisted WireGuard peer 10.77.0.1.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }
}
