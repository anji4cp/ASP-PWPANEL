# Example values for a systemd EnvironmentFile or shell session.
# Generate a unique secret; never commit the real value.
PW155_WEB_HOST=127.0.0.1
PW155_WEB_PORT=8080
PW155_WEB_CSRF_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PW155_WEB_DB_CONFIG=/etc/pw155-web/db.cnf
PW155_MONITOR_DIR=/var/lib/pw155-monitor
PW155_MAP_CONTROL_DIR=/var/lib/pw155-map-control
PW155_CPW_CONTROL_DIR=/var/lib/asp-cpw-control
PW155_BACKUP_CONTROL_DIR=/var/lib/pw155-backup-control
# Fixed destination used by Player Panel > Teleport to Safe Point.
PW155_SAFE_WORLD_TAG=1
PW155_SAFE_X=1286.669
PW155_SAFE_Y=219.375
PW155_SAFE_Z=1044.339
